DATABASE_URL=postgresql://user:pass@localhost:5432/watermark_pipeline

# SSH Worker (runs gwr — Gemini Watermark Remover)
WORKER_SSH_HOST=
WORKER_SSH_PORT=22
WORKER_SSH_USER=ubuntu
WORKER_SSH_KEY_PATH=~/.ssh/id_rsa
GWR_WORKER_DIR=/home/ubuntu/video-worker
GWR_TMP_DIR=/home/ubuntu/video-worker/tmp
GWR_VIDEO_BITRATE_MBPS=30

# YouTube Channel A
YT_CLIENT_ID_CHANNEL_A=
YT_CLIENT_SECRET_CHANNEL_A=
YT_REFRESH_TOKEN_CHANNEL_A=

# YouTube Channel B
YT_CLIENT_ID_CHANNEL_B=
YT_CLIENT_SECRET_CHANNEL_B=
YT_REFRESH_TOKEN_CHANNEL_B=

# File storage (absolute paths)
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
LOG_DIR=./logs

# Timezone — never change this
TIMEZONE=Asia/Kolkata

# Gemini API (Google AI Studio — for AI scheduling + content enrichment)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash

# Google Sheets — service account credentials
# PREFERRED: Paste the full JSON as an inline string (no file on disk = can't accidentally commit it):
#   GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
# FALLBACK (local dev only): file path to the service account JSON file
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=./service_account.json
GOOGLE_SHEETS_ID_CHANNEL_A=15di4I6FImBRN0EqXpC1azZT1BVIeTEYjRFiaMPsZOPw
GOOGLE_SHEETS_TAB_CHANNEL_A=indian_food_miniature_asmr_prompts
GOOGLE_SHEETS_ID_CHANNEL_B=1I55wxInth8l7UFWmTd5K0cBauhGO1AsM5q_bspQpvAI
GOOGLE_SHEETS_TAB_CHANNEL_B=30_fruit_growth_video_prompts

# Optional: Anthropic API key for LLM-based content enrichment
# ANTHROPIC_API_KEY=

# Channel SEO tag pools (semicolon-separated per channel)
SEO_TAGS_CHANNEL_A=cooking;recipe;food;homemade;easyrecipe;quickmeals;delicious;foodie
SEO_TAGS_CHANNEL_B=asmr;satisfying;relaxing;sounds;tapping;crunchy;asmrvideo;sleep

# Per-channel first-comment templates (optional override)
# COMMENT_TEMPLATE_CHANNEL_A=
# COMMENT_TEMPLATE_CHANNEL_B=

# ---- ASMR Content Workflow (replaces n8n "Indian ASMR Food Shorts") ----

# Telegram Bot API (for workflow notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ASMR workflow settings
ASMR_DRY_RUN=false
ASMR_SCHEDULE_CRON=0 9 * * *
ASMR_FOOD_SHEET_ID=
ASMR_FOOD_SHEET_TAB=Sheet1

# ---- Security ----

# CORS: comma-separated allowed frontend origins
# Example: ALLOWED_ORIGINS=http://localhost:5173,https://my-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# API key for bearer-token auth on all /api/* routes (except /api/health)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to disable auth (local/dev only)
API_KEY=

# JWT signing secret — MUST be set in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# At-rest encryption key for OAuth tokens stored in the database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty for plaintext storage (NOT recommended for production)
ENCRYPTION_KEY=
# For key rotation, set the old key here while ENCRYPTION_KEY holds the new key:
# ENCRYPTION_KEY_OLD=

# ---- Observability ----

# Log format: "json" (default, structured) or "text" (human-readable for local dev)
LOG_FORMAT=json
# Log level: DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO

# ---- Fault Tolerance ----

# Circuit breaker: pause queue when dead-letter job count >= this threshold
CIRCUIT_BREAKER_DLQ_THRESHOLD=5
# Stale job recovery: RUNNING jobs older than this many minutes are reset on startup
STALE_JOB_MINUTES=30

# ---- Email Notifications (Google Flow Cookie Expiry Alert) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_TO=
